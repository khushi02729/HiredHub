PORT=5000
# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hiredhub?retryWrites=true&w=majority
# At least 16 random characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
# Allowed browser origins, comma separated. Add your Vercel URL in production.
CLIENT_URL=http://localhost:5173
# Optional: absolute path of a persistent disk for resumes and avatars (defaults to backend/uploads)
# UPLOAD_DIR=/var/data/uploads
NODE_ENV=development
